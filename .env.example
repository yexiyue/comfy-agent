# server 入口加载可选 .env（.env 不进 git）；核心库只读取进程环境变量。

# 国内智谱 key（open.bigmodel.cn）。genai 里 bigmodel 适配器读这个名字
BIGMODEL_API_KEY=你的key

# bigmodel:: 前缀使用国内智谱适配器；裸写 glm-* 会走国际版 Z.ai（ZAI_API_KEY）
MODEL=bigmodel::glm-4.6

# Coding Plan API 地址。其他厂商需配套修改 MODEL 和对应的 API key。
# 未设置时 bigmodel:: 模型默认用此地址，其他模型使用 genai 默认地址。
# 显式设为空时使用 genai 默认地址（智谱默认为按量计费地址）。
API_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4/

# 每回合最多模型请求次数
AGENT_MAX_STEPS=6

# 本地 HTTP 服务与前端开发来源（逗号分隔，不能使用 *）
SERVER_ADDR=127.0.0.1:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RUST_LOG=info

# 本地 Phoenix（docker compose -f compose.phoenix.yaml up -d）
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=comfy-agent-server
PHOENIX_PROJECT_NAME=comfy-agent-local
PHOENIX_EVAL_PROJECT_NAME=comfy-agent-evals
OBS_CAPTURE_CONTENT=false
OBS_CONTENT_MAX_BYTES=16384
# 可选：将实际模型与工具指纹写入本地配置清单，供评测使用
# AGENT_CONFIG_MANIFEST=outputs/agent-config.json

# 前端（apps/web，Vite 只读取 apps/web/.env，不读仓库根目录的 .env）
# 未设置时前端默认连 http://localhost:3001
# VITE_API_BASE=http://localhost:3001
